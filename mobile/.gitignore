node_modules/
dist/
src-tauri/target/

# Regenerated by tauri-build on every compile.
src-tauri/gen/schemas/

# gen/android and gen/apple are NOT ignored: Tauri writes its own .gitignore
# inside them, they carry no machine-specific paths, and the Secure
# Enclave / Keystore plugin will have to edit Info.plist and
# AndroidManifest.xml by hand. Regenerate with `pnpm android:init` /
# `pnpm ios:init` only if they are missing.
