{
  "name": "dure-mobile",
  "license": "Apache-2.0",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src qa vite.config.ts",
    "qa:design": "vite --config qa/vite.config.ts",
    "test": "vitest run && pnpm test:push-service",
    "test:wide": "node qa/wide-window.mjs",
    "test:commit-keyboard": "node qa/commit-keyboard.mjs",
    "test:push-service": "node --test push-service/service.test.mjs",
    "tauri": "tauri",
    "ios:init": "tauri ios init",
    "ios:dev": "node ../scripts/ios-device-dev.mjs",
    "ios:build:app-store": "node ../scripts/ios-app-store-build.mjs",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-barcode-scanner": "^2.5.3",
    "@tauri-apps/plugin-biometric": "^2.5.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-haptics": "^2.4.2",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tauri-apps/cli": "^2.12.4",
    "jsdom": "^30.1.3",
    "typescript": "~5.8.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
