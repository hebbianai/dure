{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Dure",
  "description": "Dure is an agent development environment (ADE) for AI coding agents. Run AI coding agents in parallel, organize local and SSH projects, and review code changes with your existing tools and accounts.",
  "colors": {
    "primary": "#18181B",
    "light": "#FAFAFA",
    "dark": "#18181B"
  },
  "logo": {
    "light": "/logo/dure-light.svg",
    "dark": "/logo/dure-dark.svg",
    "href": "https://www.dureai.dev/"
  },
  "favicon": "/logo/favicon.svg",
  "appearance": {
    "default": "light",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0E0E11"
    }
  },
  "fonts": {
