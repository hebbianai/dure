      "family": "Inter",
      "source": "/fonts/inter-latin-wght-normal.woff2",
      "format": "woff2"
    },
    "heading": {
      "family": "Geist",
      "weight": 500,
      "source": "/fonts/geist-latin-wght-normal.woff2",
      "format": "woff2"
    }
  },
