{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "node scripts/stage-mobile-runtime.mjs && pnpm build && node scripts/stage-dure-cli.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Dure",
        "width": 1480,
        "height": 940,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "acceptFirstMouse": true,
        "backgroundThrottling": "disabled",
        "transparent": true,
        "windowEffects": {
          "effects": ["menu"],
          "state": "active",
          "radius": 12
        }
      }
    ]
  },
  "bundle": {
    "macOS": {
      "dmg": {
        "background": "icons/dmg-background.tiff",
        "windowSize": { "width": 680, "height": 420 },
        "appPosition": { "x": 180, "y": 200 },
        "applicationFolderPosition": { "x": 500, "y": 200 }
      },
      "files": {
        "Resources/resources/dure-cli": "resources/dure-cli"
      }
    },
    "targets": [
      "app",
      "dmg"
    ]
  }
}
